<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HurricaneRadioAI RC14.3</title>
<style>
body{margin:0;background:#060a1c;color:#f7fbff;font-family:-apple-system,"Hiragino Sans",sans-serif}.w{max-width:820px;margin:auto;padding:16px}.c{background:#111d45;border:1px solid #456da8;border-radius:16px;padding:16px;margin:12px 0}h1{font-size:30px}h2{margin:0 0 8px;font-size:22px}em{color:#6fefff;font-style:normal}.st{display:flex;gap:8px}.st>div{flex:1;border:1px solid #456da8;border-radius:10px;padding:9px}.ok{color:#6ef0b3}.drop{display:block;border:2px dashed #6fefff77;border-radius:12px;padding:28px;text-align:center}.drop input{display:none}button,.download{display:block;box-sizing:border-box;width:100%;padding:15px;border:0;border-radius:12px;background:#6fefff;color:#061025;text-align:center;text-decoration:none;font-weight:900;font-size:16px}button:disabled{opacity:.35}.err{display:none;margin-top:10px;padding:10px;border:1px solid #ff7899;border-radius:10px}.bar{height:12px;background:#07102b;border-radius:99px;overflow:hidden}.fill{height:100%;width:0;background:#6fefff}.muted{color:#b9c9ef}.castmode{box-sizing:border-box;width:100%;margin:8px 0 12px;background:#07102b;color:#fff;border:1px solid #456da8;border-radius:10px;padding:12px;font-size:16px}.castgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.avatarpick{display:flex;align-items:center;gap:12px;background:#07102b;border:1px solid #456da8;border-radius:12px;padding:12px;cursor:pointer}.avatarpick input{display:none}.avatarpick img{width:62px;height:62px;border-radius:12px;object-fit:cover;background:#14234a;border:2px solid #6fefff}.avatarpick img:not([src]){visibility:hidden}.avatarpick.off,.guestarea.off{display:none}.guestarea{margin-top:14px}.presetgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:8px}.preset{padding:5px;background:#07102b;color:#fff;border:2px solid #304f83;border-radius:11px;font-size:11px;line-height:1.25}.preset img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:7px;margin-bottom:5px}.preset.selected{border-color:#6fefff;box-shadow:0 0 14px #6fefff77}.profilebox{background:#07102b;border-radius:12px;padding:12px;margin:10px 0 14px}.profileline{display:grid;grid-template-columns:1fr auto auto;gap:7px;margin-top:7px}.profileline input,.profileline select{box-sizing:border-box;min-width:0;background:#111d45;color:#fff;border:1px solid #456da8;border-radius:9px;padding:10px;font-size:15px}.profileline button{width:auto;padding:10px 13px;font-size:14px}.danger{background:#ff7899!important}.probox{background:#07102b;border:1px solid #304f83;border-radius:12px;padding:10px 12px;margin:10px 0 14px}.probox summary{cursor:pointer;font-weight:800;color:#b9c9ef}.probox label{display:block;margin-top:10px}.review{display:none;border-color:#6fefff}.metaform{background:#07102b;border-radius:12px;padding:12px;margin:12px 0}.metaform label{display:block;color:#b9c9ef;font-size:13px;margin:8px 0}.metaform input{box-sizing:border-box;width:100%;margin-top:5px;background:#111d45;color:#fff;border:1px solid #456da8;border-radius:8px;padding:10px;font-size:16px}.topicrow{display:grid;grid-template-columns:90px 1fr 42px;gap:7px;align-items:end}.topicrow button{padding:10px;background:#ff7899}.smallbtn{padding:10px;margin-top:8px;background:#456da8;color:#fff}.tools{display:flex;gap:8px;align-items:center;margin:12px 0}.tools input{flex:1;background:#07102b;border:1px solid #456da8;border-radius:10px;color:#fff;padding:12px;font-size:16px}.list{max-height:62vh;overflow:auto;padding-right:4px}.seg{display:grid;grid-template-columns:92px 1fr;gap:8px;background:#081331;border:1px solid #304f83;border-radius:12px;padding:10px;margin:8px 0}.seg.unknown{border-color:#ffbd59}.meta{font-size:12px;color:#b9c9ef}.seg select,.seg textarea{box-sizing:border-box;width:100%;background:#111d45;color:#fff;border:1px solid #456da8;border-radius:8px;padding:9px;font:inherit}.seg textarea{min-height:68px;resize:vertical;margin-top:7px}.hint{background:#07102b;border-radius:10px;padding:10px;margin:10px 0}.count{white-space:nowrap;color:#6fefff;font-weight:700}.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:10px 0 14px}.thumbcard{background:#07102b;border:1px solid #456da8;border-radius:12px;padding:8px}.thumbcard img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:8px;background:#060a1c}.thumbcard a{display:block;margin-top:7px;padding:9px;border-radius:8px;background:#456da8;color:#fff;text-align:center;text-decoration:none;font-size:13px;font-weight:800}.exportgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.exportgrid .download{background:#6fefff}.exportgrid .secondary{background:#456da8;color:#fff}.exportnote{margin:8px 0 0;font-size:13px}@media(max-width:600px){.st{display:block}.st>div{margin:6px 0}.seg{grid-template-columns:1fr}.tools{align-items:stretch;flex-direction:column}.castgrid{grid-template-columns:1fr}.presetgrid{grid-template-columns:repeat(3,1fr)}.profileline{grid-template-columns:1fr 1fr}.profileline>*:first-child{grid-column:1/-1}.topicrow{grid-template-columns:78px 1fr 40px}.thumbs,.exportgrid{grid-template-columns:1fr}}
</style></head><body><main class="w">
<h1>HurricaneRadio<em>AI</em> Studio</h1><p class="muted">RC14.3 — Retro Comms / バストアップ標準 / Pro全身対応</p>
<div class="c st"><div>UI <b id="ui">確認中</b></div><div>OpenAI <b id="ai">確認中</b></div><div>Worker <b id="wk">確認中</b></div></div>
<div class="c"><b>① 出演者</b><div class="profilebox"><b>保存した出演者セット</b><div class="profileline"><select id="profiles"><option value="">保存済みセットなし</option></select><button id="loadprofile" type="button">呼び出す</button><button class="danger" id="deleteprofile" type="button">削除</button></div><div class="profileline"><input id="profilename" maxlength="30" placeholder="例：メザメさん回"><button id="saveprofile" type="button">今の設定を保存</button></div><small class="muted" id="profilemsg">名前と画像もこの端末に保存できます。</small></div><details class="probox"><summary>Pro表示設定</summary><label class="muted">キャラクター表示<select class="castmode" id="avatarframing"><option value="bust" selected>バストアップ（おすすめ・標準）</option><option value="full">全身</option></select></label><small class="muted">Simpleではバストアップが標準です。全身表示にしたい場合だけProで変更できます。</small></details><select class="castmode" id="guestmode"><option value="with">🟢 RYOKU ＋ 🎧 ゲスト</option><option value="solo">🟢 RYOKUのみ</option></select><div class="guestarea" id="guestnamebox"><label class="muted">ゲスト名<input class="castmode" id="guestname" maxlength="24" value="GUEST" placeholder="例：黄昏メザメ"></label></div><div class="castgrid"><label class="avatarpick"><img id="ryprev" alt="RYOKU画像"><input id="ryimg" type="file" accept="image/*,.png,.jpg,.jpeg,.webp"><span><b>RYOKU画像</b><br><small class="muted" id="ryn">画像を選ぶ（任意）</small></span></label><label class="avatarpick" id="guestpick"><img id="guprev" alt="ゲスト画像"><input id="guimg" type="file" accept="image/*,.png,.jpg,.jpeg,.webp"><span><b>ゲスト画像</b><br><small class="muted" id="gun">画像を選ぶ（任意）</small></span></label></div><div class="guestarea" id="guestarea"><b>またはデフォルメゲストから選ぶ</b><div class="presetgrid" id="presetgrid"></div><button class="smallbtn" id="clearpreset" type="button">画像なしのカードへ戻す</button></div><p class="muted">ゲストプリセットは同じデフォルメ画風で統一しています。話している人だけ軽く動いて発光します。</p></div>
<div class="c"><b>② 音声</b><label class="drop"><input id="f" type="file" accept="audio/*,.m4a,.mp3,.wav"><span id="fn">音声ファイルを選ぶ</span></label></div>
<div class="c"><b>③ ED曲</b><p class="muted">選ばない場合はEDなしで作成します。</p><label class="drop"><input id="ed" type="file" accept="audio/*,.m4a,.mp3,.wav"><span id="edn">ED曲を選ぶ（任意）</span></label></div>
<div class="c"><p class="muted">OP・会話BGM・声の音量補正・読みやすい字幕分割・完成QAまで自動です。</p><button id="go" disabled>✨ AIで投稿用ラジオを作る</button><div id="p" style="display:none"><p><b id="ph">準備中</b> <span id="pc"></span></p><div class="bar"><div class="fill" id="fill"></div></div></div><div class="err" id="err"></div><div id="done" style="display:none;margin-top:12px"><h2>サムネイル3案</h2><p class="muted" id="thumbmsg">画像を準備しています…</p><div class="thumbs" id="thumbs"></div><h2>完成データ</h2><div class="exportgrid"><a class="download" id="dlmp4">⬇ MP4動画</a><a class="download secondary" id="dlmp3">⬇ MP3音声</a><a class="download secondary" id="dlwav">⬇ WAV音声</a><a class="download secondary" id="dltxt">⬇ 文字起こしTXT</a></div><p class="muted exportnote">必要なものだけ個別に保存できます。WAVは高音質のため容量が大きくなります。</p></div></div>
<section class="c review" id="review"><h2>④ タイトル・話題・文字起こし確認</h2><p class="muted">AI案をそのまま使うか、ここで簡単に直せます。黄色い枠は話者未確認です。</p><div class="metaform"><label>番組タイトル<input id="mtitle" maxlength="40"></label><label>今回のテーマ<input id="mtheme" maxlength="50"></label><b>話題の切り替わり</b><div id="topiclist"></div><button class="smallbtn" id="addtopic" type="button">＋ 話題を追加</button></div><div class="hint">修正しなくても、そのまま動画作成へ進めます。</div><div class="tools"><input id="search" type="search" placeholder="字幕を検索"><span class="count" id="rcount"></span></div><div class="list" id="rlist"></div><button id="make">この内容で動画を作る</button></section>
</main><script>
let F,E,AR,AG,GP='',RYCLEAR=false,GUCLEAR=false,A=false,W=false,T,R=false,TR,S,Q=0,$=x=>document.querySelector(x);const f=$('#f'),fn=$('#fn'),ed=$('#ed'),edn=$('#edn'),go=$('#go'),p=$('#p'),ph=$('#ph'),pc=$('#pc'),fill=$('#fill'),err=$('#err'),done=$('#done'),dlmp4=$('#dlmp4'),dlmp3=$('#dlmp3'),dlwav=$('#dlwav'),dltxt=$('#dltxt'),thumbs=$('#thumbs'),thumbmsg=$('#thumbmsg'),ui=$('#ui'),ai=$('#ai'),wk=$('#wk'),review=$('#review'),rlist=$('#rlist'),rcount=$('#rcount'),search=$('#search'),make=$('#make'),guestmode=$('#guestmode'),guestnamebox=$('#guestnamebox'),guestname=$('#guestname'),guestpick=$('#guestpick'),guestarea=$('#guestarea'),presetgrid=$('#presetgrid'),clearpreset=$('#clearpreset'),ryimg=$('#ryimg'),guimg=$('#guimg'),ryprev=$('#ryprev'),guprev=$('#guprev'),ryn=$('#ryn'),gun=$('#gun'),profiles=$('#profiles'),profilename=$('#profilename'),saveprofile=$('#saveprofile'),loadprofile=$('#loadprofile'),deleteprofile=$('#deleteprofile'),profilemsg=$('#profilemsg'),mtitle=$('#mtitle'),mtheme=$('#mtheme'),topiclist=$('#topiclist'),addtopic=$('#addtopic');
const PRESETS=[['guest-00','男性・元気'],['guest-01','男性・クール'],['guest-02','女性・明るい'],['guest-03','女性・ストリート'],['guest-04','女性・華やか'],['guest-05','中性的'],['guest-06','メガネ'],['guest-07','パーカー'],['guest-08','ロボット'],['guest-09','ミステリー']].map(x=>({id:x[0],name:x[1],src:`/assets/guest-presets/${x[0]}.webp`}));
function key(){let u=new URL(location.href),v=u.searchParams.get('access')||(location.hash.match(/access=([^&]+)/)||[])[1];if(v){v=decodeURIComponent(v);try{localStorage.hraiAccess=v}catch{}return v}try{return localStorage.hraiAccess||''}catch{return''}}
function savedJob(){try{let x=JSON.parse(localStorage.hraiJob||'null');return x&&x.jobId&&x.workerToken?x:null}catch{return null}}
let K=key();function ready(){go.disabled=!(F&&A&&W&&K)}
f.onchange=e=>{F=e.target.files[0];fn.textContent=F?F.name:'音声ファイルを選ぶ';done.style.display='none';review.style.display='none';R=false;ready()};
ed.onchange=e=>{E=e.target.files[0];edn.textContent=E?'🎵 '+E.name:'ED曲を選ぶ（任意）';done.style.display='none'};
guestmode.onchange=()=>{let solo=guestmode.value==='solo';guestnamebox.classList.toggle('off',solo);guestpick.classList.toggle('off',solo);guestarea.classList.toggle('off',solo);done.style.display='none'};
ryimg.onchange=e=>{AR=e.target.files[0];RYCLEAR=false;ryn.textContent=AR?AR.name:'画像を選ぶ（任意）';if(AR)ryprev.src=URL.createObjectURL(AR);done.style.display='none'};
guimg.onchange=e=>{AG=e.target.files[0];GP='';GUCLEAR=false;gun.textContent=AG?AG.name:'画像を選ぶ（任意）';if(AG)guprev.src=URL.createObjectURL(AG);renderPresets();done.style.display='none'};
function renderPresets(){presetgrid.textContent='';for(const x of PRESETS){let b=document.createElement('button'),im=document.createElement('img'),t=document.createElement('span');b.type='button';b.className='preset'+(GP===x.id?' selected':'');b.dataset.id=x.id;im.src=x.src;im.alt=x.name;t.textContent=x.name;b.append(im,t);b.onclick=()=>selectPreset(x);presetgrid.appendChild(b)}}
function selectPreset(x){GP=x.id;AG=null;GUCLEAR=false;guimg.value='';guprev.src=x.src;gun.textContent='プリセット：'+x.name;renderPresets();done.style.display='none'}
clearpreset.onclick=()=>{GP='';AG=null;GUCLEAR=true;guimg.value='';guprev.removeAttribute('src');gun.textContent='画像なし（デザインカード）';renderPresets();done.style.display='none'};
async function presetFile(){let x=PRESETS.find(x=>x.id===GP);if(!x)return null;let r=await fetch(x.src);if(!r.ok)throw Error('プリセット画像を読み込めません');let b=await r.blob();return new File([b],x.id+'.webp',{type:b.type||'image/webp'})}
function castDb(){return new Promise((ok,no)=>{let q=indexedDB.open('hrai-cast-profiles',1);q.onupgradeneeded=()=>q.result.createObjectStore('profiles',{keyPath:'id'});q.onsuccess=()=>ok(q.result);q.onerror=()=>no(q.error)})}
async function castStore(mode,value){let d=await castDb();return new Promise((ok,no)=>{let tx=d.transaction('profiles',mode),s=tx.objectStore('profiles'),q=value===undefined?s.getAll():mode==='readwrite'&&value?.delete?s.delete(value.id):s.put(value);q.onsuccess=()=>ok(q.result);q.onerror=()=>no(q.error);tx.oncomplete=()=>d.close()})}
async function refreshProfiles(selected=''){let list=await castStore('readonly');profiles.textContent='';let z=document.createElement('option');z.value='';z.textContent=list.length?'保存したセットを選ぶ':'保存済みセットなし';profiles.appendChild(z);list.sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt))).forEach(x=>{let o=document.createElement('option');o.value=x.id;o.textContent=x.name;profiles.appendChild(o)});profiles.value=selected;return list}
saveprofile.onclick=async()=>{try{let name=profilename.value.trim();if(!name)throw Error('セット名を入力してください');let id=profiles.value||('cast_'+Date.now()+'_'+Math.random().toString(16).slice(2)),item={id,name,guestEnabled:guestmode.value==='with',guestName:guestname.value.trim()||'GUEST',avatarFraming:avatarframing.value==='full'?'full':'bust',guestPreset:GP,ryokuBlob:AR||null,guestBlob:AG||null,updatedAt:new Date().toISOString()};await castStore('readwrite',item);await refreshProfiles(id);profilemsg.textContent='「'+name+'」をこの端末に保存しました';profilename.value=''}catch(e){profilemsg.textContent='保存できません：'+e.message}};
loadprofile.onclick=async()=>{try{let id=profiles.value;if(!id)throw Error('セットを選んでください');let list=await castStore('readonly'),x=list.find(x=>x.id===id);if(!x)throw Error('保存データが見つかりません');guestmode.value=x.guestEnabled?'with':'solo';guestname.value=x.guestName||'GUEST';avatarframing.value=x.avatarFraming==='full'?'full':'bust';guestmode.onchange();AR=x.ryokuBlob?new File([x.ryokuBlob],'ryoku-profile.png',{type:x.ryokuBlob.type||'image/png'}):null;RYCLEAR=!AR;if(AR){ryprev.src=URL.createObjectURL(AR);ryn.textContent=x.name+'のRYOKU画像'}else{ryprev.removeAttribute('src');ryn.textContent='画像を選ぶ（任意）'}AG=x.guestBlob?new File([x.guestBlob],'guest-profile.png',{type:x.guestBlob.type||'image/png'}):null;GP=x.guestPreset||'';GUCLEAR=!AG&&!GP;if(AG){guprev.src=URL.createObjectURL(AG);gun.textContent=x.name+'のゲスト画像'}else if(GP){let q=PRESETS.find(p=>p.id===GP);if(q){guprev.src=q.src;gun.textContent='プリセット：'+q.name}}else{guprev.removeAttribute('src');gun.textContent='画像なし（デザインカード）'}renderPresets();profilemsg.textContent='「'+x.name+'」を呼び出しました'}catch(e){profilemsg.textContent='呼び出せません：'+e.message}};
deleteprofile.onclick=async()=>{try{let id=profiles.value;if(!id)throw Error('削除するセットを選んでください');let name=profiles.selectedOptions[0]?.textContent||'出演者セット';await castStore('readwrite',{delete:true,id});await refreshProfiles();profilemsg.textContent='「'+name+'」を削除しました'}catch(e){profilemsg.textContent='削除できません：'+e.message}};
function prog(n,s){p.style.display='block';ph.textContent=s;pc.textContent=Math.round(n)+'%';fill.style.width=n+'%'}function fail(s){err.style.display='block';err.textContent='安全停止：'+s;go.disabled=false}
async function boot(){renderPresets();try{await refreshProfiles()}catch{profilemsg.textContent='この端末では出演者セット保存を利用できません'}try{let j=await fetch('/api/health').then(r=>r.json());ui.textContent=j.ok?'LIVE':'ERROR';ui.className=j.ok?'ok':''}catch{}try{let j=await fetch('/api/openai-status').then(r=>r.json());A=j.configured&&j.reachable;ai.textContent=A?'接続済み':'待機';ai.className=A?'ok':''}catch{}try{let j=await fetch('/api/worker-status').then(r=>r.json());W=j.ready;wk.textContent=W?'READY':'待機';wk.className=W?'ok':''}catch{}ready();let old=savedJob();if(old){S=old;prog(2,'前回の作業へ再接続中');try{await api('/api/resume-job',old,{},55000)}catch(e){if(/job_not_found|source_missing|unauthorized/.test(e.message)){try{localStorage.removeItem('hraiJob')}catch{}return fail('前回の作業環境は終了しました。音声を選び直してください')}}poll(old)}}
async function api(path,s,extra={},wait=30000){const c=new AbortController(),tm=setTimeout(()=>c.abort(),wait);try{let r=await fetch(path,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({jobId:s.jobId,workerToken:s.workerToken,...extra}),signal:c.signal}),j={};try{j=await r.json()}catch{}if(!r.ok)throw Error((j.error||path+' '+r.status)+(j.detail?': '+j.detail:''));return j}catch(e){if(e.name==='AbortError')throw Error('connection_timeout');throw e}finally{clearTimeout(tm)}}
function b64(file){return new Promise((ok,no)=>{let r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]||'');r.onerror=()=>no(Error('ファイル読込エラー'));r.readAsDataURL(file)})}
async function upload(s,file){const size=1500000;await api('/api/upload-init',s,{bytes:file.size,filename:file.name});for(let off=0,i=0;off<file.size;off+=size,i++){let part=file.slice(off,Math.min(file.size,off+size)),audioBase64=await b64(part);await api('/api/upload-chunk',s,{index:i,audioBase64});prog(3+4*Math.min(file.size,off+size)/file.size,'音声を安全に転送中')}await api('/api/upload-complete',s,{bytes:file.size,filename:file.name})}
async function uploadEd(s,file){const size=1500000;await api('/api/ed-upload-init',s,{bytes:file.size